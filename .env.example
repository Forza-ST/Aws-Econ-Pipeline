# ── Copy this file to .env and fill in values ──────────────────────────────
# .env is git-ignored. NEVER commit real values.

# AWS (use IAM role in CI — these are for local dev only)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# S3
S3_BUCKET_RAW=econ-pipeline-raw-dev
S3_BUCKET_CLEAN=econ-pipeline-clean-dev
S3_BUCKET_CURATED=econ-pipeline-curated-dev

# API Keys (stored in AWS Secrets Manager in prod — local dev only here)
FRED_API_KEY=your_fred_api_key_here
BLS_API_KEY=your_bls_api_key_here
METALS_API_KEY=your_metals_api_key_here
EXCHANGE_RATE_API_KEY=your_exchange_rate_key_here

# Redshift (dev — use Secrets Manager in prod)
REDSHIFT_HOST=your-cluster.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=econ_db
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=CHANGE_ME

# Slack alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Environment tag
ENVIRONMENT=dev
