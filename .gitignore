# ── Secrets & credentials (NEVER commit these) ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*
*secret*
!configs/**/*secret*.example
terraform.tfvars
!terraform.tfvars.example
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
backend.hcl
!backend.hcl.example

# AWS specific
.aws/
aws-exports.js

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# ── Notebooks ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
# Strip notebook outputs before committing
# notebooks/*.ipynb  <-- do NOT ignore whole file, just outputs (handled by nbstripout)

# ── Data files (never commit raw/sensitive data) ─────────────────────────────
data/
*.csv
*.parquet
*.json.gz
*.jsonl
!configs/**/*.json
!tests/fixtures/**/*.json

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── dbt ──────────────────────────────────────────────────────────────────────
configs/dbt/target/
configs/dbt/dbt_packages/
configs/dbt/logs/

# ── Terraform ────────────────────────────────────────────────────────────────
**/.terraform/
*.tfplan
override.tf
override.tf.json
*_override.tf

# ── Great Expectations ───────────────────────────────────────────────────────
configs/great_expectations/uncommitted/

# ── Build artifacts ───────────────────────────────────────────────────────────
*.zip
lambda_packages/
lambda_layer.zip
layer_build/
lambda_package/
